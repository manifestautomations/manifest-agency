# Cache directory - ignore contents but keep structure
.cache/*
!.cache/.gitkeep
!.cache/github/
.cache/github/*
!.cache/github/.gitkeep

# Worker runtime files (logs and locks are ephemeral)
.worker/logs/*
!.worker/logs/.gitkeep
.worker/locks/*
!.worker/locks/.gitkeep
.worker/audit/*.audit.jsonl
.worker/audit/*.jsonl.gz
!.worker/audit/.gitkeep
!.worker/audit/chain.json

# Violations tracking (trust-scores.json is tracked for team visibility)
.worker/violations/*-violations.jsonl
.worker/violations/incident-*.json
!.worker/violations/.gitkeep
!.worker/violations/trust-scores.json

# Orchestrator dispatch state (ephemeral runtime data)
.worker/dispatch/*
!.worker/dispatch/.gitkeep

# Approval workflow state (registry.jsonl tracked for audit trail)
.worker/approvals/pending/*
!.worker/approvals/pending/.gitkeep
.worker/approvals/approved/*
!.worker/approvals/approved/.gitkeep
.worker/approvals/denied/*
!.worker/approvals/denied/.gitkeep
!.worker/approvals/.gitkeep
!.worker/approvals/registry.jsonl

# Briefing state (history archived, current state ephemeral)
.worker/briefings/*
!.worker/briefings/.gitkeep
!.worker/briefings/history/
.worker/briefings/history/*
!.worker/briefings/history/.gitkeep

# Dashboard cache (ephemeral performance cache)
.worker/cache/*
!.worker/cache/.gitkeep
