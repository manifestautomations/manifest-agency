# Cache directory - ignore contents but keep structure
.cache/*
!.cache/.gitkeep
!.cache/github/
.cache/github/*
!.cache/github/.gitkeep

# Worker runtime files (logs and locks are ephemeral)
.worker/logs/*
!.worker/logs/.gitkeep
.worker/locks/*
!.worker/locks/.gitkeep
.worker/audit/*.audit.jsonl
.worker/audit/*.jsonl.gz
!.worker/audit/.gitkeep
!.worker/audit/chain.json

# Violations tracking (trust-scores.json is tracked for team visibility)
.worker/violations/*-violations.jsonl
.worker/violations/incident-*.json
!.worker/violations/.gitkeep
!.worker/violations/trust-scores.json
